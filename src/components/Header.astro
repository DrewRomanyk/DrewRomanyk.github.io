<style>
  header {
    border-bottom: 1px solid var(--color-border);
    padding: 0.75rem 0;
    position: sticky;
    top: 0;
    background: var(--color-bg);
    z-index: 10;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .header-name {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--color-text);
  }

  .header-name:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 1.25rem;
    align-items: center;
  }

  nav a {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 0.15s;
  }

  nav a:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  nav a span {
    display: none;
  }

  @media (min-width: 600px) {
    nav a span {
      display: inline;
    }
  }

  .theme-toggle {
    background: none;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 0.35rem;
    cursor: pointer;
    color: var(--color-text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.15s, border-color 0.15s;
  }

  .theme-toggle:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  /* Show sun in dark mode, moon in light mode */
  .icon-sun {
    display: none;
  }

  :global([data-theme="dark"]) .icon-sun {
    display: block;
  }

  :global([data-theme="dark"]) .icon-moon {
    display: none;
  }
</style>
