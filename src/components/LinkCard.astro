---
interface Props {
  name: string;
  url: string;
  description?: string;
}

const { name, url, description } = Astro.props;
---

<a href={url} class="link-card" target="_blank" rel="noopener">
  <span class="link-name">{name}</span>
  {description && <span class="link-desc">{description}</span>}
  <svg class="arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path d="M7 17L17 7M17 7H7M17 7V17" />
  </svg>
</a>

<style>
  .link-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-card-bg);
    color: var(--color-text);
    transition: border-color 0.15s;
  }

  .link-card:hover {
    border-color: var(--color-accent);
    color: var(--color-text);
  }

  .link-name {
    font-weight: 500;
  }

  .link-desc {
    color: var(--color-text-secondary);
    font-size: 0.85rem;
  }

  .arrow {
    margin-left: auto;
    color: var(--color-text-secondary);
    flex-shrink: 0;
  }

  .link-card:hover .arrow {
    color: var(--color-accent);
  }
</style>
