---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = [
  {
    name: 'Minesweeper',
    description:
      'Classic minesweeper game built for Android and web. Thousands of downloads on the Google Play Store with features like multiple difficulty levels and first-click safety.',
    tags: ['Android', 'Java', 'JavaScript'],
    links: [
      { label: 'Play Store', url: 'https://play.google.com/store/apps/details?id=com.romanyknativ.minesweeper' },
      { label: 'Web', url: '/minesweeperWeb/' },
      { label: 'GitHub', url: 'https://github.com/DrewRomanyk/MineSweeper-Android' },
    ],
  },
];
---

<BaseLayout title="Drew Romanyk">
  <section class="hero">
    <p class="greeting">👋 Howdy, I'm</p>
    <h1>Drew Romanyk</h1>
    <p class="bio">
      I'm a senior software engineer at <strong>Databricks</strong> where I work on
      frontend serving infrastructure; GraphQL infrastructure, UI asset serving, logging
      systems, and in-house analytics solutions.
    </p>
  </section>

  <section class="projects">
    <h2>Projects</h2>
    <div class="project-grid">
      {projects.map((project) => <ProjectCard {...project} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 5rem 0 3rem;
  }

  .greeting {
    font-size: 1.8rem;
    color: var(--color-accent);
    font-weight: 700;
    margin-bottom: 0.15rem;
    letter-spacing: -0.01em;
  }

  .hero h1 {
    margin-bottom: 1.25rem;
    font-size: 2.8rem;
  }

  .bio {
    font-size: 1.1rem;
    line-height: 1.8;
    max-width: 580px;
  }

  .bio strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .projects {
    padding: 2rem 0 5rem;
    border-top: 1px solid var(--color-border);
  }

  .project-grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .project-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
